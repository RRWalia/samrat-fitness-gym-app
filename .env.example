# Server Configuration
PORT=5001
NODE_ENV=development

# Database (resolved from the backend working directory)
DB_PATH=./gym.db

# Authentication
# REQUIRED in production. Generate at least 32 random characters, for example:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_TTL_SECONDS=28800
JWT_REMEMBER_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# First-run owner bootstrap (used only when the Users table is empty)
INITIAL_OWNER_USERNAME=ashish
INITIAL_OWNER_NAME="Ashish"
INITIAL_OWNER_PASSWORD=Samrat@Fitness2026!
# Re-apply the INITIAL_*_PASSWORD values to EXISTING accounts on every boot.
# Needed on hosts without shell access (e.g. Render Free) because the seeder
# otherwise only runs while the Users table is empty. Leave false normally.
STAFF_PASSWORD_SYNC=false
# Set true if production must fail instead of auto-generating a missing first owner password.
STRICT_PRODUCTION_BOOTSTRAP=false
# Optional: where to store the generated bootstrap password if INITIAL_OWNER_PASSWORD is omitted.
# INITIAL_OWNER_PASSWORD_FILE=./.initial-owner-password

# Optional first-run staff accounts. Omit passwords to skip these in production.
# INITIAL_MANAGER_USERNAME=parmar
# INITIAL_MANAGER_NAME="Parmar"
# INITIAL_MANAGER_PASSWORD=Manager@2026!
# INITIAL_FRONT_DESK_USERNAME=frontdesk
# INITIAL_FRONT_DESK_NAME="Front Desk Team"
# INITIAL_FRONT_DESK_PASSWORD=FrontDesk@2026!
# INITIAL_TRAINER_USERNAME=sona.walia
# INITIAL_TRAINER_NAME="Sona Walia"
# INITIAL_TRAINER_PASSWORD=Trainer@2026!
# INITIAL_TRAINER_ID=101

# Gym Settings
GYM_NAME="Samrat Fitness King"
TIMEZONE="Asia/Kolkata"
DEFAULT_NO_SHOW_THRESHOLD=10
