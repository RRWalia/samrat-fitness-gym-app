# Server Configuration
PORT=5001
NODE_ENV=development

# Database (resolved from the backend working directory)
DB_PATH=./gym.db

# Authentication
# REQUIRED in production. Generate at least 32 random characters, for example:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_TTL_SECONDS=28800
JWT_REMEMBER_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# First-run owner bootstrap (used only when the Users table is empty)
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_NAME="Samrat Gym Owner"
INITIAL_OWNER_PASSWORD=ChangeThis_Owner_2026!

# Optional first-run staff accounts. Omit passwords to skip these in production.
# INITIAL_MANAGER_USERNAME=manager
# INITIAL_MANAGER_NAME="Gym Manager"
# INITIAL_MANAGER_PASSWORD=replace-with-a-strong-temporary-password
# INITIAL_FRONT_DESK_USERNAME=frontdesk
# INITIAL_FRONT_DESK_NAME="Front Desk Team"
# INITIAL_FRONT_DESK_PASSWORD=replace-with-a-strong-temporary-password
# INITIAL_TRAINER_USERNAME=trainer.aryan
# INITIAL_TRAINER_NAME="Coach Aryan"
# INITIAL_TRAINER_PASSWORD=replace-with-a-strong-temporary-password
# INITIAL_TRAINER_ID=101

# Gym Settings
GYM_NAME="Samrat Fitness King"
TIMEZONE="Asia/Kolkata"
DEFAULT_NO_SHOW_THRESHOLD=10
