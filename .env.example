# Server Configuration
PORT=5001
NODE_ENV=development

# Database (resolved from the backend working directory)
DB_PATH=./gym.db

# Authentication
# REQUIRED in production. Generate at least 32 random characters, for example:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_TTL_SECONDS=28800
JWT_REMEMBER_TTL_SECONDS=2592000

# Sign in with Google (Web OAuth client ID from the Google Cloud console).
# REQUIRED: Google is the only sign-in method — there are no passwords.
# In the Google console, add every origin that serves the app (e.g.
# http://localhost:3000 for local dev and your https://… production origin) to
# "Authorized JavaScript origins". Only the client ID is used; the client
# secret from the console download is not needed by this app.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com

# First-run owner bootstrap (used only when the Users table is empty).
# The owner signs in with Google using exactly this Gmail address.
INITIAL_OWNER_EMAIL=owner@gmail.com
INITIAL_OWNER_NAME="Ashish"
# Optional staff accounts for the first run. Omit any to skip it.
# INITIAL_MANAGER_EMAIL=manager@gmail.com
# INITIAL_MANAGER_NAME="Parmar"
# INITIAL_FRONT_DESK_EMAIL=frontdesk@gmail.com
# INITIAL_FRONT_DESK_NAME="Front Desk Team"
# INITIAL_TRAINER_EMAIL=trainer@gmail.com
# INITIAL_TRAINER_NAME="Sona Walia"
# INITIAL_TRAINER_ID=101

# Gym Settings
GYM_NAME="Samrat Fitness King"
TIMEZONE="Asia/Kolkata"
DEFAULT_NO_SHOW_THRESHOLD=10
